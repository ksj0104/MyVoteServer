# Separate ASR-text gateway; does not modify the existing mTLS audio server.
# REQUIRED: generate with python -c 'import secrets; print(secrets.token_urlsafe(32))'
STREAMING_API_KEY=
TRANSLATION_BASE_URL=http://127.0.0.1:1234/v1
TRANSLATION_API_KEY=lm-studio
TRANSLATION_MODEL=google/gemma-4-26b-a4b
TRANSLATION_TIMEOUT=30
TRANSLATION_WORKERS=4
TRANSLATION_TEMPERATURE=0.1
STABILITY_HISTORY=4
STABILITY_THRESHOLD=0.75
STABILITY_AGREEMENT_WEIGHT=0.35
STABILITY_CONFIDENCE_WEIGHT=0.30
STABILITY_AGE_WEIGHT=0.20
STABILITY_PAUSE_WEIGHT=0.15
HOLD_PARTIAL_TAIL=true
MIN_STABLE_TOKENS=3
MIN_SEGMENT_TOKENS=5
TARGET_SEGMENT_TOKENS=10
MAX_SEGMENT_TOKENS=24
ALLOW_OVERSIZE_COMPLETE=true
MAX_SEGMENT_LATENCY_MS=1500
TRANSLATION_DEBOUNCE_MS=150
TRANSLATION_STABILITY_COUNT=2
TRANSLATION_COMMIT_DELAY_MS=700
CONTEXT_SEGMENTS=3
MAX_CONTEXT_TOKENS=1500
MAX_SESSIONS=32
SESSION_INACTIVITY_SECONDS=1800
MAX_PENDING_JOBS=128
MAX_PENDING_PER_SESSION=16
MAX_STATE_BYTES=65536
MAX_SNAPSHOT_BYTES=524288
RAW_TRANSCRIPT_LOGGING=false
